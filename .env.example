# URL /exec del Web App de Apps Script (solo se usa en el servidor, /api/sheets)
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Debe coincidir con API_SECRET en clasp-src/secreto.js (proyecto Apps Script)
APPS_SCRIPT_SECRET=
# Contraseña de acceso al panel; las sesiones se firman con ella
ADMIN_PASSWORD=
